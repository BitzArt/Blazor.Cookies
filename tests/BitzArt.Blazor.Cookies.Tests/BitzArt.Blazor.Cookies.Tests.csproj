			<PrivateAssets>all</PrivateAssets>
		</PackageReference>
		<PackageReference Include="Microsoft.Testing.Extensions.CodeCoverage" Version="18.12.0">
			<PrivateAssets>all</PrivateAssets>
		</PackageReference>
		<PackageReference Include="Microsoft.Testing.Extensions.TrxReport" Version="2.5.1">
			<PrivateAssets>all</PrivateAssets>
		</PackageReference>
